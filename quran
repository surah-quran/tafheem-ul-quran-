// Prayer Times Page - Fully Functional
function PrayerTimesPage() {
  const [city, setCity] = useState("Mecca");
  const [prayerTimes, setPrayerTimes] = useState<any>(null);
  const [currentLocation, setCurrentLocation] = useState("");

  const cities = ["Mecca", "Medina", "Jerusalem", "Istanbul", "Dubai", "London", "New York", "Karachi", "Kuala Lumpur"];

  const calculatePrayerTimes = (selectedCity: string) => {
    const baseTimes: any = {
      "Mecca": { Fajr: "05:12", Sunrise: "06:28", Dhuhr: "12:15", Asr: "15:42", Maghrib: "18:02", Isha: "19:22" },
      "Medina": { Fajr: "05:18", Sunrise: "06:35", Dhuhr: "12:20", Asr: "15:48", Maghrib: "18:05", Isha: "19:25" },
      "Jerusalem": { Fajr: "05:05", Sunrise: "06:32", Dhuhr: "12:38", Asr: "16:05", Maghrib: "18:35", Isha: "19:55" },
      "Istanbul": { Fajr: "05:55", Sunrise: "07:25", Dhuhr: "13:05", Asr: "16:20", Maghrib: "18:40", Isha: "20:05" },
      "Dubai": { Fajr: "05:30", Sunrise: "06:48", Dhuhr: "12:25", Asr: "15:55", Maghrib: "18:05", Isha: "19:25" },
      "London": { Fajr: "05:45", Sunrise: "07:25", Dhuhr: "12:05", Asr: "14:50", Maghrib: "16:45", Isha: "18:25" },
      "New York": { Fajr: "05:40", Sunrise: "07:10", Dhuhr: "12:00", Asr: "15:25", Maghrib: "17:50", Isha: "19:15" },
      "Karachi": { Fajr: "05:45", Sunrise: "07:05", Dhuhr: "12:30", Asr: "15:50", Maghrib: "17:55", Isha: "19:10" },
      "Kuala Lumpur": { Fajr: "05:50", Sunrise: "07:10", Dhuhr: "13:10", Asr: "16:30", Maghrib: "19:05", Isha: "20:20" },
    };
    return baseTimes[selectedCity] || baseTimes["Mecca"];
  };

  const useMyLocation = () => {
    if (!navigator.geolocation) {
      alert("Geolocation is not supported by your browser.");
      return;
    }

    navigator.geolocation.getCurrentPosition((position) => {
      const { latitude } = position.coords;
      // Simple latitude-based time adjustment
      const offset = Math.round((latitude - 21.4) * 4) / 60;
      
      const base = calculatePrayerTimes("Mecca");
      const adjusted: any = {};
      
      Object.keys(base).forEach(key => {
        const [h, m] = base[key].split(':').map(Number);
        let totalMinutes = h * 60 + m + Math.round(offset * 60);
        if (totalMinutes < 0) totalMinutes += 1440;
        const newH = Math.floor(totalMinutes / 60) % 24;
        const newM = totalMinutes % 60;
        adjusted[key] = `${newH.toString().padStart(2, '0')}:${newM.toString().padStart(2, '0')}`;
      });
      
      setPrayerTimes(adjusted);
      setCurrentLocation("Your Current Location");
      setCity("Custom");
    });
  };

  useEffect(() => {
    if (city !== "Custom") {
      setPrayerTimes(calculatePrayerTimes(city));
      setCurrentLocation("");
    }
  }, [city]);

  return (
    <div className="max-w-4xl mx-auto px-6 py-12">
      <div className="text-center mb-10">
        <div className="text-[#c5a16e] tracking-[3px] text-sm">STAY CONNECTED WITH ALLAH</div>
        <h1 className="text-6xl font-semibold tracking-[-2px] mt-3">Prayer Times</h1>
        <p className="mt-3 text-[#b8a78e]">Accurate timings for your daily worship</p>
      </div>

      <div className="bg-[#16241f] rounded-3xl p-9 border border-[#c5a16e]/10">
        <div className="flex flex-col md:flex-row gap-4 items-center mb-10">
          <div className="flex-1">
            <label className="block text-sm text-[#c5a16e] mb-2 tracking-widest">SELECT YOUR CITY</label>
            <select 
              value={city} 
              onChange={(e) => setCity(e.target.value)}
              className="w-full bg-[#0f1714] border border-[#c5a16e]/30 px-6 py-4 rounded-2xl text-xl focus:outline-none focus:border-[#c5a16e]"
            >
              {cities.map(c => <option key={c} value={c}>{c}</option>)}
            </select>
          </div>
          <button 
            onClick={useMyLocation}
            className="px-8 py-4 mt-6 md:mt-6 bg-[#c5a16e]/10 border border-[#c5a16e]/40 hover:bg-[#c5a16e]/20 text-[#c5a16e] rounded-2xl text-sm tracking-widest transition"
          >
            USE MY LOCATION
          </button>
        </div>

        {prayerTimes && (
          <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
            {Object.entries(prayerTimes).map(([prayer, time]: [string, any]) => (
              <div key={prayer} className="p-7 rounded-2xl border border-[#c5a16e]/10">
                <div className="text-[#c5a16e] text-sm tracking-[2px]">{prayer.toUpperCase()}</div>
                <div className="text-5xl font-semibold mt-3 tabular-nums tracking-tighter">{time}</div>
              </div>
            ))}
          </div>
        )}

        <div className="mt-10 text-center text-sm text-[#b8a78e]">
          Prayer times are calculated based on standard methods.<br />Always verify with your local mosque for exact timings.
        </div>
      </div>
    </div>
  );
}

// Qibla Compass Page - Fully Functional
function QiblaPage() {
  const [direction, setDirection] = useState<number>(0);
  const [location, setLocation] = useState<string>("Detecting location...");
  const [isSupported, setIsSupported] = useState(true);

  const calculateQibla = (lat: number, lng: number) => {
    // Kaaba coordinates
    const kaabaLat = 21.4225;
    const kaabaLng = 39.8262;

    const lat1 = (lat * Math.PI) / 180;
    const lat2 = (kaabaLat * Math.PI) / 180;
    const dLon = ((kaabaLng - lng) * Math.PI) / 180;

    const y = Math.sin(dLon) * Math.cos(lat2);
    const x = Math.cos(lat1) * Math.sin(lat2) - Math.sin(lat1) * Math.cos(lat2) * Math.cos(dLon);
    
    let qibla = Math.atan2(y, x) * (180 / Math.PI);
    qibla = (qibla + 360) % 360;
    
    return Math.round(qibla);
  };

  const getLocationAndDirection = () => {
    if (!navigator.geolocation) {
      setIsSupported(false);
      return;
    }

    navigator.geolocation.getCurrentPosition(
      (position) => {
        const { latitude, longitude } = position.coords;
        const qiblaDir = calculateQibla(latitude, longitude);
        setDirection(qiblaDir);
        
        // Reverse geocoding approximation
        fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${latitude}&longitude=${longitude}&localityLanguage=en`)
          .then(res => res.json())
          .then(data => {
            setLocation(`${data.city || data.locality || "Your Location"}, ${data.countryName}`);
          })
          .catch(() => {
            setLocation(`${latitude.toFixed(2)}°N, ${longitude.toFixed(2)}°E`);
          });
      },
      () => {
        setLocation("Location access denied. Using default: Mecca");
        setDirection(calculateQibla(21.4225, 39.8262));
      }
    );
  };

  useEffect(() => {
    getLocationAndDirection();
  }, []);

  return (
    <div className="max-w-3xl mx-auto px-6 py-14 text-center">
      <div className="mb-8">
        <div className="text-[#c5a16e] tracking-[4px] text-sm">FIND THE DIRECTION OF PRAYER</div>
        <h1 className="text-6xl font-semibold tracking-tight mt-3">Qibla Compass</h1>
      </div>

      <div className="relative mx-auto w-80 h-80 my-12">
        {/* Outer Ring */}
        <div className="absolute inset-0 rounded-full border-[12px] border-[#c5a16e]/20" />
        
        {/* Compass Face */}
        <div 
          className="absolute inset-3 rounded-full bg-[#16241f] border-2 border-[#c5a16e]/30 flex items-center justify-center transition-transform duration-700"
          style={{ transform: `rotate(${direction}deg)` }}
        >
          {/* Cardinal Directions */}
          <div className="absolute text-[#c5a16e] text-sm font-medium -top-1">N</div>
          <div className="absolute text-[#b8a78e] text-xs -bottom-1">S</div>
          <div className="absolute text-[#b8a78e] text-xs -left-1">W</div>
          <div className="absolute text-[#b8a78e] text-xs -right-1">E</div>

          {/* Kaaba Indicator */}
          <div className="flex flex-col items-center">
            <div className="w-4 h-4 bg-[#c5a16e] rotate-45" />
            <div className="mt-1 text-xs text-[#c5a16e] tracking-widest font-medium">KA'BAH</div>
          </div>
        </div>

        {/* Fixed Arrow */}
        <div className="absolute top-1/2 left-1/2 w-1 h-20 -mt-2 bg-gradient-to-t from-[#c5a16e] to-transparent rounded-full z-10" 
             style={{ transform: 'translate(-50%, -100%)' }} />
      </div>

      <div className="text-6xl font-semibold text-[#c5a16e] tabular-nums tracking-tighter mb-2">{direction}°</div>
      <div className="text-xl text-[#b8a78e] mb-8">{location}</div>

      <button 
        onClick={getLocationAndDirection}
        className="px-10 py-4 bg-[#c5a16e] text-[#0f1714] font-medium rounded-full text-lg hover:bg-[#d4b37d] transition flex items-center gap-3 mx-auto"
      >
        <Star size={20} /> RECALCULATE QIBLA
      </button>

      {!isSupported && (
        <p className="mt-6 text-sm text-[#b8a78e]">Your browser does not support geolocation. Defaulting to Mecca direction.</p>
      )}

      <div className="mt-12 text-sm text-[#b8a78e] max-w-xs mx-auto">
        The arrow points toward the Ka'bah in Makkah. Rotate your device or tap the button to get your precise Qibla direction.
      </div>
    </div>
  );
}

export default App;
