// Surah Detail Page - The core reading experience
function SurahDetailPage() {
  const { number } = useParams<{ number: string }>();
  const surahNum = parseInt(number || '1');
  const surah = surahsData.find(s => s.number === surahNum)!;
  const ayahs = ayahsData.filter(a => a.surahNumber === surahNum);
  
  const [bookmarks, setBookmarks] = useState<number[]>([]);
  const [readAyahs, setReadAyahs] = useState<number[]>([]);
  const [playingId, setPlayingId] = useState<number | null>(null);
  const [notes, setNotes] = useState<Record<number, string>>({});

  // Load bookmarks, progress & notes from localStorage
  useEffect(() => {
    const savedBookmarks = JSON.parse(localStorage.getItem('tafheem_bookmarks') || '[]');
    const savedRead = JSON.parse(localStorage.getItem('tafheem_read') || '[]');
    const savedNotes = JSON.parse(localStorage.getItem('tafheem_notes') || '{}');
    setBookmarks(savedBookmarks);
    setReadAyahs(savedRead);
    setNotes(savedNotes);
  }, []);

  const toggleBookmark = (ayahId: number) => {
    let newBookmarks: number[];
    if (bookmarks.includes(ayahId)) {
      newBookmarks = bookmarks.filter(id => id !== ayahId);
    } else {
      newBookmarks = [...bookmarks, ayahId];
    }
    setBookmarks(newBookmarks);
    localStorage.setItem('tafheem_bookmarks', JSON.stringify(newBookmarks));
  };

  const toggleRead = (ayahId: number) => {
    let newRead: number[];
    if (readAyahs.includes(ayahId)) {
      newRead = readAyahs.filter(id => id !== ayahId);
    } else {
      newRead = [...readAyahs, ayahId];
    }
    setReadAyahs(newRead);
    localStorage.setItem('tafheem_read', JSON.stringify(newRead));
  };

  const saveNote = (ayahId: number, noteText: string) => {
    const updatedNotes = { ...notes, [ayahId]: noteText };
    setNotes(updatedNotes);
    localStorage.setItem('tafheem_notes', JSON.stringify(updatedNotes));
  };

  const shareAyah = (ayah: Ayah) => {
    const surah = surahsData.find(s => s.number === ayah.surahNumber)!;
    const text = `${ayah.arabic}\n\n${ayah.english}\n\n— ${surah.name} ${ayah.ayahNumber}\n\nTafheem: ${ayah.tafheem}\n\nShared from Tafheem ul Quran`;
    
    navigator.clipboard.writeText(text).then(() => {
